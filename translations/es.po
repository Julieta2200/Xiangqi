msgid "SPECIAL_CARD_TREE_TRUNK_DESC"
msgstr "Coloca un Tronco de Árbol en cualquier casilla fuera del palacio.\nNinguna unidad puede estar o pasar por esta casilla.\nEl Tronco de Árbol desaparece después de 2 turnos."

msgid "SPECIAL_CARD_SNAKE_CHAIN_DESC"
msgstr "Coloca una Cadena de Serpiente en una unidad enemiga.\nEsa unidad queda inmovilizada y no puede moverse.\nLa Cadena de Serpiente desaparece después de 2 turnos."

msgid "SPECIAL_CARD_WATER_PORTAL_DESC"
msgstr "Coloca un Portal de Agua en cualquier casilla fuera del palacio.\nSi una unidad enemiga pisa o intenta atravesar esta casilla, es eliminada al instante.\nEl Portal de Agua desaparece después de 2 turnos."

msgid "SPECIAL_CARD_DISCONNECTION_MIST_DESC"

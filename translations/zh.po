msgid "LEVEL_1_BOSS_HINT_1"
msgstr "Navak可以沿纵向或横向移动任意数量的空格。"

msgid "LEVEL_1_BOSS_HINT_2"
msgstr "Stver可以沿横向或纵向穿越任意数量的空格。\n\t可以跳过一枚己方或敌方棋子。\n\t只能这样做来俘获位于其后方任意距离的棋子。"

msgid "HINT_SOLDIER_MOVE_TEXT"
msgstr "士兵通过向前移动一格来走棋和吃子。一旦兵卒过河，也可以横向移动和吃子。兵卒永远不能后退。"

msgid "HINT_SOLDIER_MOVE_DIALOG"

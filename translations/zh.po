msgid "HINT_GENERAL_MOVE_TEXT"
msgstr "将（帅）可以沿纵向或横向移动一格，但不能斜向移动，且被限制在九宫格内的九个点。"

msgid "HINT_GENERAL_MOVE_DIALOG"

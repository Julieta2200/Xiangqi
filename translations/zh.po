msgid "SPECIAL_CARD_TREE_TRUNK_DESC"
msgstr "在九宫格外的任意格子上放置树干。\n没有单位可以站在这个格子上或穿过它。\n树干在2回合后消失。"

msgid "SPECIAL_CARD_SNAKE_CHAIN_DESC"
msgstr "将蛇链放置在一个敌方单位上。\n该单位被固定，无法移动。\n蛇链在2回合后消失。"

msgid "SPECIAL_CARD_WATER_PORTAL_DESC"
msgstr "在九宫格外的任意格子上放置水之门户。\n如果敌方单位踏上或试图穿过这个格子，它会立即被消灭。\n水之门户在2回合后消失。"

msgid "SPECIAL_CARD_DISCONNECTION_MIST_DESC"
